@using Microsoft.AspNetCore.Http
@{
    var nombreUsuario = Context.Session.GetString("Nombre");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CostaRicaMusic.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-top">
                <div class="brand-circle">
                    <i class="bi bi-music-note-beamed"></i>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" title="Inicio">
                    <i class="bi bi-house-door-fill"></i>
                </a>

                <a class="sidebar-link @(currentController == "Cancion" ? "active" : "")" asp-controller="Cancion" asp-action="Index" title="Canciones">
                    <i class="bi bi-music-note-list"></i>
                </a>

                <a class="sidebar-link @(currentController == "Playlist" ? "active" : "")" asp-controller="Playlist" asp-action="Index" title="Playlists">
                    <i class="bi bi-collection-play-fill"></i>
                </a>

                <a class="sidebar-link @(currentController == "Artista" ? "active" : "")" asp-controller="Artista" asp-action="Index" title="Artistas">
                    <i class="bi bi-person-fill"></i>
                </a>

                <a class="sidebar-link @(currentController == "Album" ? "active" : "")" asp-controller="Album" asp-action="Index" title="Álbumes">
                    <i class="bi bi-disc-fill"></i>
                </a>
            </nav>

            <div class="sidebar-bottom">
                @if (!string.IsNullOrEmpty(nombreUsuario))
                {
                    <div class="sidebar-user">@nombreUsuario</div>
                    <a class="sidebar-link small-link" asp-controller="Auth" asp-action="Logout" title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                }
                else
                {
                    <a class="sidebar-link small-link" asp-controller="Auth" asp-action="Login" title="Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                    </a>
                }
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" class="nav-arrow-btn" onclick="history.back()">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="nav-arrow-btn" onclick="history.forward()">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                <div class="topbar-brand">
                    <i class="bi bi-music-note-beamed"></i>
                    <span>Costa Rica Music</span>
                </div>

                <div class="topbar-right">
                    @if (!string.IsNullOrEmpty(nombreUsuario))
                    {
                        <div class="user-pill">
                            <i class="bi bi-person-circle"></i>
                            <span>@nombreUsuario</span>
                        </div>
                    }
                </div>
            </header>

            <main class="app-content">
                <div class="content-panel">
                    <div class="main-content-layout">
                        <div class="main-left">
                            @RenderBody()
                        </div>

                        <div class="main-right">
                            <partial name="_NowPlayingPanel" />
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <div class="global-player-bar">
        <div class="player-left">
            <div class="player-artwork">
                <img id="playerArtworkImg" src="~/images/albums/default-cover.jpg" alt="Portada" />
            </div>
            <div class="player-meta">
                <div class="player-song-title" id="playerSongTitle">Ninguna canción seleccionada</div>
                <div class="player-song-subtitle" id="playerSongArtist">Costa Rica Music</div>
            </div>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button type="button" class="player-btn" id="btnPrevious">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button type="button" class="player-btn player-btn-primary" id="btnPlayPause">
                    <i class="bi bi-play-fill"></i>
                </button>
                <button type="button" class="player-btn" id="btnNext">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
            </div>

            <div class="player-progress-wrap">
                <span class="player-time" id="playerCurrentTime">0:00</span>

                <input type="range"
                       id="playerProgress"
                       class="player-progress"
                       min="0"
                       max="100"
                       value="0" />

                <span class="player-time" id="playerDuration">0:00</span>
            </div>

            <audio id="globalPlayer" class="player-audio"></audio>
        </div>

        <div class="player-right">
            <div class="player-volume-wrap">
                <i class="bi bi-volume-up-fill"></i>
                <input type="range"
                       id="playerVolume"
                       class="player-volume"
                       min="0"
                       max="1"
                       step="0.01"
                       value="1" />
            </div>
        </div>
    </div>

    <script src="~/js/player.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>