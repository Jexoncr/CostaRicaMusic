@model CostaRicaMusic.Web.Models.PlaylistDetailsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Detalle Playlist";

    var playlistSongsOrdered = Model.Playlist.PlaylistCanciones != null
        ? Model.Playlist.PlaylistCanciones.OrderBy(x => x.Orden).ToList()
        : new List<CostaRicaMusic.DAL.Entities.PlaylistCancion>();

    var playlistSongs = playlistSongsOrdered.Select(x => new
    {
        nombre = x.Cancion?.Nombre ?? "",
        artista = x.Cancion?.Artista?.Nombre ?? "Artista desconocido",
        artistaId = x.Cancion?.ArtistaId,
        artistaPais = x.Cancion?.Artista?.Pais ?? "",
        artistaDescripcion = x.Cancion?.Artista?.Descripcion ?? "",
        artistaImagenUrl = !string.IsNullOrEmpty(x.Cancion?.Artista?.ImagenUrl)
        ? Url.Content("~/" + x.Cancion.Artista.ImagenUrl.TrimStart('/'))
        : Url.Content("~/images/artists/default-artist.jpg"),
        portadaUrl = !string.IsNullOrEmpty(x.Cancion?.Album?.PortadaUrl)
        ? Url.Content("~/" + x.Cancion.Album.PortadaUrl.TrimStart('/'))
        : Url.Content("~/images/albums/default-cover.jpg"),
        audioUrl = string.IsNullOrEmpty(x.Cancion?.AudioUrl)
        ? ""
        : Url.Content("~/" + x.Cancion.AudioUrl.TrimStart('/'))
    }).ToList();

    var playlistSongsJson = JsonSerializer.Serialize(playlistSongs);

    var coverUrl = Url.Content("~/images/albums/default-cover.jpg");
    var firstSong = playlistSongsOrdered.FirstOrDefault();

    if (!string.IsNullOrEmpty(firstSong?.Cancion?.Album?.PortadaUrl))
    {
        coverUrl = Url.Content("~/" + firstSong.Cancion.Album.PortadaUrl.TrimStart('/'));
    }
}

<div class="playlist-details-hero mb-4">
    <div class="playlist-details-cover">
        <img src="@coverUrl" alt="Portada playlist" />
    </div>

    <div class="playlist-details-info">
        <span class="section-badge">Playlist</span>
        <h1 class="display-6 fw-bold mt-3 mb-2">@Model.Playlist.Nombre</h1>
        <p class="soft-label mb-3">
            @playlistSongsOrdered.Count canciones • @Model.Playlist.FechaCreacion.ToString("dd/MM/yyyy")
        </p>

        <div class="d-flex gap-2 flex-wrap">
            @if (playlistSongs.Any())
            {
                <button type="button"
                        class="btn btn-success"
                        onclick='playPlaylistSong(@Html.Raw(playlistSongsJson), 0)'>
                    <i class="bi bi-play-fill me-2"></i> Reproducir
                </button>
            }

            <div class="dropdown">
                <button class="btn btn-outline-light rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Playlist.Id">
                            <i class="bi bi-pencil-square me-2"></i>Editar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@Model.Playlist.Id">
                            <i class="bi bi-trash me-2"></i>Eliminar
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}

<div class="music-section-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Canciones en la playlist</h3>
        <span class="soft-label">@playlistSongsOrdered.Count canciones</span>
    </div>

    @if (playlistSongsOrdered.Any())
    {
        <div class="track-list">
            @{
                var playlistSongIndex = 0;
            }

            @foreach (var item in playlistSongsOrdered)
            {
                var itemCover = !string.IsNullOrEmpty(item.Cancion?.Album?.PortadaUrl)
                    ? Url.Content("~/" + item.Cancion.Album.PortadaUrl.TrimStart('/'))
                    : Url.Content("~/images/albums/default-cover.jpg");

                <div class="track-row">
                    <div class="track-main">
                        <span class="track-number">@(playlistSongIndex + 1)</span>
                        <div class="track-cover">
                            <img src="@itemCover" alt="Portada" />
                        </div>
                        <div class="track-info">
                            <div class="track-title">@item.Cancion?.Nombre</div>
                            <div class="track-meta">
                                <span class="music-link">@item.Cancion?.Artista?.Nombre</span>
                                <span class="track-dot">•</span>
                                <span class="music-link">@item.Cancion?.Album?.Titulo</span>
                            </div>
                        </div>
                    </div>

                    <div class="track-side">
                        <button type="button"
                                class="btn btn-success btn-sm play-song-btn"
                                onclick='playPlaylistSong(@Html.Raw(playlistSongsJson), @playlistSongIndex)'>
                            <i class="bi bi-play-fill"></i>
                        </button>
                        <form asp-action="RemoveSong" method="post" class="d-inline">
                            <input type="hidden" name="playlistId" value="@Model.Playlist.Id" />
                            <input type="hidden" name="cancionId" value="@item.CancionId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar de playlist">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                playlistSongIndex++;
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-music-note-list"></i>
            <p class="mb-0">Esta playlist todavía no tiene canciones.</p>
        </div>
    }
</div>

<div class="music-section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h3 class="mb-1">Agregar más canciones</h3>
            <p class="soft-label mb-0">Busca canciones en el catálogo y agrégalas a esta playlist.</p>
        </div>

        <a asp-controller="Cancion" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-music-note-list me-2"></i> Ir al catálogo
        </a>
    </div>
</div>