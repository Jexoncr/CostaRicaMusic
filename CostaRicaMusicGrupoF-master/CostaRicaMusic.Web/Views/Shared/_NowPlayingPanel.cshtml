<div class="now-playing-panel">
    <h5 class="mb-3">Reproduciendo ahora</h5>
    
    <div class="now-playing-card mb-4">
        <img id="np-cover" src="~/images/albums/default-cover.jpg" alt="Portada actual" />

        <div class="np-info">
            <strong id="np-title">Selecciona una canción</strong>
            <a id="np-artist" href="#" class="np-artist-link">—</a>
        </div>

        <div class="np-bars">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>

    <div class="artist-spotlight-card">
        <div class="artist-spotlight-header">
            <span class="section-badge">Artista actual</span>
        </div>

        <div class="artist-spotlight-image">
            <img id="np-artist-image" src="~/images/artists/default-artist.jpg" alt="Artista actual" />
        </div>

        <div class="artist-spotlight-info">
            <h6 id="np-artist-name">Sin artista seleccionado</h6>
            <p id="np-artist-country" class="soft-label mb-2">—</p>
            <p id="np-artist-description" class="artist-spotlight-description">
                Reproduce una canción para ver información del artista.
            </p>
        </div>
    </div>

</div>